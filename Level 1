import pyglet

window = pyglet.window.Window(1000, 700)

soldier_img = pyglet.image.load("soldatGeg.png")

soldiers = []

class Soldier:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.speed = 2

    def move(self):
        self.x += self.speed

    def draw(self):
        soldier_img.blit(self.x, self.y)

# Spawn
for i in range(5):
    soldiers.append(Soldier(100, 100 + i * 60))


def update(dt):
    for s in soldiers:
        s.move()


@window.event
def on_draw():
    window.clear()

    for s in soldiers:
        s.draw()


pyglet.clock.schedule_interval(update, 1/60)

pyglet.app.run()